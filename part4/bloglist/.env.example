# Copy this file to .env and fill in your own values. Never commit .env.
# MONGODB_URI is the MongoDB Atlas connection string for the
# blog list database. TEST_MONGODB_URI is a separate database
# used when NODE_ENV=test. SECRET is the JWT signing secret.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
TEST_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/testBloglistApp?retryWrites=true&w=majority
SECRET=choose-a-long-random-secret
PORT=3003
