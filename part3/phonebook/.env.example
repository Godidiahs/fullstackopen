# Copy this file to .env and fill in your own values. Never commit .env.
# MONGODB_URI is the MongoDB Atlas connection string for the
# phonebook database (exercises 3.12-3.14). PORT is used by
# hosting services such as Render/Fly.io (3.21); locally the
# server defaults to 3001.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=3001
